# ==== Python ====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ==== Virtual environments ====
venv/
env/
.venv/
.env/
ENV/

# ==== Environment variables / secrets ====
.env
.env.local
*.pem
*.key
config/secrets.yaml

# ==== Dati grezzi e processati (versionati con DVC, non con Git) ====
data/raw/*
!data/raw/*.dvc
!data/raw/.gitignore
data/processed/*
!data/processed/.gitkeep
!data/processed/*.dvc
!data/processed/.gitignore
*.csv
*.parquet
*.db
*.sqlite
*.sqlite3

# ==== DVC ====
# DVC gestisce i suoi metadati, ma non i file di dati veri e propri
.dvc/cache
.dvc/tmp

# ==== MLflow ====
mlruns/
mlartifacts/
mlflow.db
mlflow.db-*

# ==== Modelli allenati ====
*.pkl
*.joblib
*.h5
*.pt
models/*
!models/.gitkeep
!models/baseline_latest/
!models/baseline_latest/model.joblib
!models/baseline_latest/metrics.json
!models/baseline_latest/dataset.json

# ==== Jupyter Notebooks (checkpoint, non i notebook stessi) ====
.ipynb_checkpoints/

# ==== Airflow ====
airflow.db
airflow.cfg
logs/
airflow-webserver.pid

# ==== Docker ====
*.env.docker

# ==== Log files ====
*.log
logs/

# ==== Evidently / monitoring reports ====
reports/**
!reports/.gitkeep
!reports/drift_latest/report.html

# ==== Scraper: cache HTML grezzo (se salvato temporaneamente) ====
scraper/cache/

# ==== IDE ====
.vscode/
.idea/
*.swp
*.swo

# ==== OS ====
.DS_Store
Thumbs.db

